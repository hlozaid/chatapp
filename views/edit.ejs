<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit</title>
  </head>
  <body>
    <h3>Edit Msg <%=chat._id %></h3>
    <form action="/chats/<%= chat._id%>?_method=PUT" method="POST">
      <textarea name="msg" rows="6" cols="50"><%= chat.msg %></textarea>
      <button>Edit</button> 
    </form>
  </body>
</html>
